    "echarts": "^6.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^17.4.4",
    "openapi-typescript": "^7.13.0",
